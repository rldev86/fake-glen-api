import glen.net.*;
import glen.json.*;
import glen.runtime.Exception;
import glen.collections.generic.Thread;
import glen.time.Timer;

public class Client {
    private static String baseUrl(String[] args) {
        if (args.length > 0) { return args[0]; }
        return "http://127.0.0.1:7700";
    }

    private static JsonObject requireJsonObject(HttpResponse response, String endpoint) {
        if (!response.isSuccess()) {
            throw new Exception(
                "HTTP request failed for " + endpoint
                + ": status=" + response.statusCode()
                + " body=" + response.body()
            );
        }
        return response.parseJsonObject();
    }

    private static void printPreview(JsonArray clients, int limit) {
        int count = clients.size();
        if (limit > count) { limit = count; }
        for (int i = 0; i < limit; i = i + 1) {
            JsonObject client = clients.getObject(i);
            IO.println(client.getString("name") + " <" + client.getString("email") + "> - " + client.getString("plan"));
        }
        if (count > limit) {
            IO.println("... skipped " + (count - limit) + " more clients");
        }
    }

    public static void main(String[] args) {
        String api = baseUrl(args);
        HttpClient http = HttpClient.create().timeoutMillis(15000).acceptJson();

        Timer total = Timer.start();

        Thread healthTask = Thread.spawn(() -> {
            Timer t = Timer.start();
            JsonObject health = requireJsonObject(http.get(api + "/health"), "GET /health");
            IO.println("health=" + health.getString("status") + " in " + t.elapsedMillis() + "ms");
        });

        Thread clientsTask = Thread.spawn(() -> {
            Timer t = Timer.start();
            HttpResponse clientsResponse = http.get(api + "/clients");
            int networkMs = t.elapsedMillis();

            Timer parseTimer = Timer.start();
            JsonObject root = requireJsonObject(clientsResponse, "GET /clients");
            JsonArray clients = root.getArray("clients");
            int parseMs = parseTimer.elapsedMillis();

            IO.println("status=" + clientsResponse.statusCode());
            IO.println("count=" + clients.size());
            IO.println("download+response=" + networkMs + "ms");
            IO.println("json-parse=" + parseMs + "ms");
            printPreview(clients, 10);
        });

        healthTask.join();
        clientsTask.join();

        Thread oneTask = Thread.spawn(() -> {
            JsonObject one = requireJsonObject(http.get(api + "/clients/2"), "GET /clients/2");
            IO.println("client 2 city=" + one.getObject("client").getString("city"));
        });

        Thread validationTask = Thread.spawn(() -> {
            JsonObject payload = Json.object()
                .setString("name", "Eva Rocha")
                .setString("email", "eva@example.com")
                .setString("city", "Florianopolis")
                .setString("plan", "Business");

            HttpResponse validationResponse = http.postJson(api + "/clients/validate", payload.toJson());
            JsonObject validation = requireJsonObject(validationResponse, "POST /clients/validate");
            IO.println(validation.getString("message"));
        });

        oneTask.join();
        validationTask.join();
        IO.println("total=" + total.elapsedMillis() + "ms");
    }
}
