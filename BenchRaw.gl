import glen.net.internal.backend.HttpNative;
import glen.time.Timer;
public class BenchRaw { public static void main() { Timer t = Timer.start(); String raw = HttpNative.request("GET", "http://127.0.0.1:7703/clients", "Accept: application/json\r\nAccept-Encoding: identity\r\n", "", 15000); IO.println("raw bytes=" + raw.byteLength()); IO.println("native ms=" + t.elapsedMillis()); } }
